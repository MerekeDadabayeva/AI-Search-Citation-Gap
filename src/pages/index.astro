---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import Topbar from "../components/Topbar.astro";
import OverviewView from "../components/OverviewView.astro";
import SinglePromptWorkspace from "../components/SinglePromptWorkspace.astro";
import PortfolioWorkspace from "../components/PortfolioWorkspace.astro";
import ApiKeyModal from "../components/ApiKeyModal.astro";
import "../styles/global.css";
---

<Layout title="Peec AI — AI Search Analytics & Citation Gap Synthesizer">
  <div class="peec-app">
    <!-- Left Navigation Sidebar -->
    <Sidebar />

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
      <!-- Global Topbar & Filters -->
      <Topbar />

      <!-- View 1: Overview Dashboard (Peec AI Native Look) -->
      <OverviewView />

      <!-- View 2: Autonomous Citation Gap Synthesizer (Single & Portfolio Modes) -->
      <main id="view-gap" class="view-pane">
        <!-- Diagnostic Workspace Header -->
        <div class="gap-workspace-header">
          <div>
            <div class="workspace-tag">Peec AI &bull; Autonomous Remediation Engine</div>
            <h1 class="workspace-title">Citation Gap Synthesizer</h1>
            <p class="workspace-sub">
              Enter <strong>any brand URL, competitor URL, and search prompt</strong>. The live synthesizer scrapes both pages in real time and computes the exact proof points and tags needed to win AI search citations.
            </p>
          </div>
        </div>

        <!-- Mode Switcher Pill Bar -->
        <div class="mode-switcher-bar">
          <button class="mode-btn active" id="btnSingleMode">
            <span>🎯 Single Prompt Live Analysis</span>
          </button>
          <button class="mode-btn" id="btnPortfolioMode">
            <span>📦 Portfolio Mode (Fix Once, Win Multiple Prompts)</span>
            <span class="mode-badge">HIGH LEVERAGE</span>
          </button>
        </div>

        <!-- Track A: Single Prompt Live Workspace -->
        <SinglePromptWorkspace />

        <!-- Track B: Portfolio Mode Multi-Prompt Aggregator -->
        <PortfolioWorkspace />
      </main>

      <!-- View 3: Prompts Tab -->
      <main id="view-prompts" class="view-pane">
        <div class="empty-state-card">
          <h2>🎯 Monitored Search Prompts</h2>
          <p>Tracking 24 prompts across ChatGPT Search, Perplexity AI, and Google Gemini.</p>
          <button class="btn-primary-black" style="margin-top: 14px;" id="btnGoToGap">Run Citation Gap Analysis on Active Prompts →</button>
        </div>
      </main>

      <!-- View 4: Sources Tab -->
      <main id="view-sources" class="view-pane">
        <div class="empty-state-card">
          <h2>🌐 Citation Sources &amp; Domains</h2>
          <p>Auditing 142 citation domains (UGC, Editorial, Industry Directories).</p>
        </div>
      </main>

      <!-- View 5: Models Tab -->
      <main id="view-models" class="view-pane">
        <div class="empty-state-card">
          <h2>🤖 AI Engine Breakdown</h2>
          <p>Comparing citation visibility across OpenAI ChatGPT-4o, Perplexity Sonar, and Google Gemini 1.5 Pro.</p>
        </div>
      </main>

      <!-- View 6: Settings Tab -->
      <main id="view-settings" class="view-pane">
        <div class="empty-state-card">
          <h2>⚙️ Brand &amp; Workspace Settings</h2>
          <p>Manage workspace team members, brand profiles, and webhook alerts.</p>
        </div>
      </main>
    </div>
  </div>

  <!-- Optional Live API Key Settings Modal -->
  <ApiKeyModal />

  <!-- Client-Side App Lifecycle Controller -->
  <script>
    import { initApp } from "../scripts/appController";
    initApp();
  </script>
</Layout>

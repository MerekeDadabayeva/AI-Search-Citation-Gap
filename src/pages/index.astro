    padding: 4px 12px;
    font-size: 0.76rem;
    font-weight: 500;
    color: #4B5563;
    cursor: pointer;
    transition: all 0.12s;
  }
  .chip:hover {
    border-color: #6366F1;
    color: #6366F1;
    background: #EEF2FF;
  }
  .chip-active {
    border-color: #6366F1;
    color: #6366F1;
    background: #EEF2FF;
    font-weight: 600;
  }

  /* ── Scorecards ─────────────────────────────────────────── */
  .scorecard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .stat-box {
    padding: 16px;
  }
  .stat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .stat-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #6B7280;
  }
  .stat-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .stat-badge.red { background: #FEE2E2; color: #B91C1C; }
  .stat-badge.amber { background: #FEF3C7; color: #B45309; }
  .stat-badge.purple { background: #EDE9FE; color: #6D28D9; }
  .stat-badge.green { background: #D1FAE5; color: #047857; }

  .stat-number {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .stat-number.danger { color: #EF4444; }
  .stat-number.warning { color: #F59E0B; }
  .stat-number.purple { color: #8B5CF6; }
  .stat-number.success { color: #10B981; }
  .stat-hint {
    font-size: 0.72rem;
    color: #9CA3AF;
  }

  /* ── Matrix Card ────────────────────────────────────────── */
  .matrix-card {
    padding: 0;
    overflow: hidden;
    margin-bottom: 24px;
  }
  .matrix-header {
    display: grid;
    grid-template-columns: 240px 1fr 1fr;
    background: #F9FAFB;
    border-bottom: 1px solid #E5E7EB;
    padding: 12px 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6B7280;
  }
  .matrix-row {
    display: grid;
    grid-template-columns: 240px 1fr 1fr;
    border-bottom: 1px solid #E5E7EB;
  }
  .matrix-row:last-child {
    border-bottom: none;
  }
  .row-info {
    padding: 18px 20px;
    background: #F9FAFB;
    border-right: 1px solid #E5E7EB;
  }
  .row-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 2px;
  }
  .row-desc {
    font-size: 0.74rem;
    color: #6B7280;
    line-height: 1.4;
  }
  .row-cell {
    padding: 18px 20px;
    font-size: 0.85rem;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    border-right: 1px solid #E5E7EB;
    line-height: 1.45;
  }
  .row-cell:last-child { border-right: none; }
  .row-cell .icon { font-weight: 700; font-size: 0.9rem; flex-shrink: 0; }
  .row-cell.cell-missing { background: #FEF2F2; color: #991B1B; }
  .row-cell.cell-missing .icon { color: #EF4444; }
  .row-cell.cell-has { background: #F0FDF4; color: #166534; }
  .row-cell.cell-has .icon { color: #10B981; }
  .row-cell.cell-partial { background: #FFFBEB; color: #92400E; }
  .row-cell.cell-partial .icon { color: #F59E0B; }

  /* ── Action Items Feed ──────────────────────────────────── */
  .action-feed-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .feed-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111827;
  }
  .feed-subtitle {
    font-size: 0.78rem;
    color: #6B7280;
  }
  .action-items-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }
  .action-item-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 18px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: border-color 0.12s;
  }
  .action-item-card:hover {
    border-color: #6366F1;
  }
  .action-num {
    width: 24px;
    height: 24px;
    background: #EEF2FF;
    color: #4F46E5;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .action-content {
    flex: 1;
  }
  .action-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 2px;
  }
  .action-desc {
    font-size: 0.8rem;
    color: #4B5563;
    line-height: 1.45;
  }
  .action-tags {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }
  .action-tag {
    font-size: 0.68rem;
    padding: 2px 6px;
    background: #F3F4F6;
    border-radius: 4px;
    color: #6B7280;
    font-weight: 500;
  }
  .btn-copy-fix {
    border: 1px solid #E5E7EB;
    background: #FFFFFF;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 0.76rem;
    font-weight: 600;
    color: #4B5563;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.12s;
    flex-shrink: 0;
  }
  .btn-copy-fix:hover {
    border-color: #6366F1;
    color: #6366F1;
    background: #EEF2FF;
  }
  .btn-copy-fix.copied {
    border-color: #10B981;
    color: #10B981;
    background: #ECFDF5;
  }

  /* ── Export & Handoff Bar ───────────────────────────────── */
  .export-handoff-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
  }
  .handoff-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111827;
  }
  .handoff-desc {
    font-size: 0.8rem;
    color: #6B7280;
    margin-top: 2px;
  }
  .handoff-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .btn-outline {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    transition: all 0.12s;
  }
  .btn-outline:hover {
    background: #F9FAFB;
    border-color: #D1D5DB;
  }
  .btn-black {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #111827;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.12s;
  }
  .btn-black:hover {
    background: #000000;
  }

  /* ── Empty States ───────────────────────────────────────── */
  .empty-state-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 40px;
    text-align: center;
    color: #4B5563;
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 900px) {
    .sidebar { display: none; }
    .dashboard-grid-top,
    .dashboard-grid-bottom { grid-template-columns: 1fr; }
    .scorecard-grid { grid-template-columns: 1fr 1fr; }
    .matrix-header, .matrix-row { grid-template-columns: 140px 1fr 1fr; }
    .export-handoff-card { flex-direction: column; gap: 14px; align-items: flex-start; }
  }
</style>

<script>
  import type { CitationGapResult } from "../lib/types";
  import { PRESETS } from "../lib/presets";
  import { ZeroExtrapolationDiffEngine } from "../lib/diffEngine";

  // ── Tab & View Navigation ─────────────────────────────────────────────
  const navButtons = document.querySelectorAll(".nav-item[data-view]");
  const viewPanes = document.querySelectorAll(".view-pane");

  function switchView(viewId: string) {
    viewPanes.forEach(pane => pane.classList.remove("active"));
    navButtons.forEach(btn => btn.classList.remove("active"));

    const targetPane = document.getElementById(viewId);
    if (targetPane) targetPane.classList.add("active");

    const targetBtn = document.querySelector(`.nav-item[data-view="${viewId}"]`);
    if (targetBtn) targetBtn.classList.add("active");
  }

  navButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      const viewId = (btn as HTMLElement).dataset.view!;
      switchView(viewId);
    });
  });

  // Callout & Leaderboard Quick Actions to jump into Citation Gap view
  document.getElementById("openGapFromBanner")?.addEventListener("click", () => {
    switchView("view-gap");
  });

  document.getElementById("btnGoToGap")?.addEventListener("click", () => {
    switchView("view-gap");
  });

  document.querySelectorAll(".table-diagnose-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const comp = (btn as HTMLElement).dataset.comp || "monday.com";
      const compInput = document.getElementById("compUrlInput") as HTMLInputElement;
      if (compInput) compInput.value = `https://${comp}`;
      switchView("view-gap");
      runAnalysis();
    });
  });

  // ── Gap Analyzer Engine ────────────────────────────────────────────────
  const brandInput = document.getElementById("brandUrlInput") as HTMLInputElement;
  const compInput = document.getElementById("compUrlInput") as HTMLInputElement;
  const queryInput = document.getElementById("queryInput") as HTMLInputElement;
  const analyzeBtn = document.getElementById("analyzeBtn") as HTMLButtonElement;
  let currentResult: CitationGapResult | null = null;

  // Preset Chips
  document.querySelectorAll(".chip[data-preset]").forEach(chip => {
    chip.addEventListener("click", () => {
      document.querySelectorAll(".chip").forEach(c => c.classList.remove("chip-active"));
      chip.classList.add("chip-active");
      const key = (chip as HTMLElement).dataset.preset!;
      const p = PRESETS[key];
      if (p) {
        brandInput.value = p.brandUrl;
        compInput.value = p.competitorUrl;
        queryInput.value = p.query;
        runAnalysis();
      }
    });
  });

  analyzeBtn?.addEventListener("click", runAnalysis);

  function getDomain(url: string) {
    try { return new URL(url).hostname.replace(/^www\./, ""); }
    catch { return url; }
  }

  function escHtml(str: string) {
    return String(str)
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;");
  }

  function runAnalysis() {
    if (!analyzeBtn) return;
    analyzeBtn.innerHTML = "<span>Analyzing...</span>";
    analyzeBtn.disabled = true;

    setTimeout(() => {
      let brandPayload, compPayload;
      const presetKey = Object.keys(PRESETS).find(k =>
        PRESETS[k].brandUrl === brandInput.value && PRESETS[k].competitorUrl === compInput.value
      );
      if (presetKey) {
        brandPayload = PRESETS[presetKey].brandData;
        compPayload = PRESETS[presetKey].competitorData;
      } else {
        brandPayload = ZeroExtrapolationDiffEngine.createPayloadForUrl(brandInput.value, true);
        compPayload = ZeroExtrapolationDiffEngine.createPayloadForUrl(compInput.value, false);
      }

      const result = ZeroExtrapolationDiffEngine.executeDiff(
        queryInput.value,
        brandPayload,
        compPayload
      );

      renderGapUI(result);
      analyzeBtn.innerHTML = "<span>🚀 Synthesize Citation Gap</span>";
      analyzeBtn.disabled = false;
    }, 150);
  }

  function renderGapUI(result: CitationGapResult) {
    currentResult = result;
    const brandDom = getDomain(result.brandPayload.url);
    const compDom = getDomain(result.competitorPayload.url);

    // Scorecard stats
    const statSchema = document.getElementById("statSchemaCount");
    const statBench = document.getElementById("statBenchmarkCount");
    const statEntity = document.getElementById("statEntityCount");
    if (statSchema) statSchema.textContent = String(result.schemaGaps.length);
    if (statBench) statBench.textContent = String(result.benchmarkGaps.length);
    if (statEntity) statEntity.textContent = String(result.entityGaps.length);

    // Matrix headers
    const labelBrand = document.getElementById("labelBrand");
    const labelComp = document.getElementById("labelComp");
    if (labelBrand) labelBrand.textContent = `Your Brand (${brandDom})`;
    if (labelComp) labelComp.textContent = `Winning Competitor (${compDom})`;

    // Matrix cells - Schema
    const cellSchemaBrand = document.getElementById("cellSchemaBrand");
    const textSchemaBrand = document.getElementById("textSchemaBrand");
    const textSchemaComp = document.getElementById("textSchemaComp");
    if (result.schemaGaps.length > 0) {
      if (cellSchemaBrand) cellSchemaBrand.className = "row-cell cell-missing";
      if (textSchemaBrand) textSchemaBrand.textContent = `Missing ${result.schemaGaps.map(g => g.schemaType).join(", ")}`;
      if (textSchemaComp) textSchemaComp.textContent = `Has ${result.schemaGaps.map(g => g.schemaType).join(", ")} + Organization`;
    } else {
      if (cellSchemaBrand) cellSchemaBrand.className = "row-cell cell-has";
      if (textSchemaBrand) textSchemaBrand.textContent = "All schemas matched";
    }

    // Matrix cells - Benchmarks
    const textBenchmarkBrand = document.getElementById("textBenchmarkBrand");
    const textBenchmarkComp = document.getElementById("textBenchmarkComp");
    if (result.benchmarkGaps.length > 0) {
      const compProof = result.benchmarkGaps.slice(0, 2).map(g => g.competitorValue).join(", ");
      if (textBenchmarkBrand) textBenchmarkBrand.textContent = "No quantitative SLA or scale statistics stated";
      if (textBenchmarkComp) textBenchmarkComp.textContent = `Quotes: ${compProof}`;
    }

    // Matrix cells - Entities
    const textEntityBrand = document.getElementById("textEntityBrand");
    const textEntityComp = document.getElementById("textEntityComp");
    if (textEntityBrand) textEntityBrand.textContent = `Partial (${result.entityGaps.length} critical topic entities omitted)`;
    if (textEntityComp) textEntityComp.textContent = `Complete coverage across categorical prompt keywords`;

    // Action Feed
    renderActionFeed(result);
  }

  function renderActionFeed(result: CitationGapResult) {
    const list = document.getElementById("actionItemsList");
    if (!list) return;

    const actions: Array<{ title: string; desc: string; tag: string; copyText: string }> = [];

    // Schema Actions
    result.schemaGaps.forEach(g => {
      actions.push({
        title: `Inject Schema.org @type ${g.schemaType}`,
        desc: g.impactReason,
        tag: "Technical SEO &bull; &lt;15 min",
        copyText: g.recommendedJsonLd
      });
    });

    // Benchmark Actions
    result.benchmarkGaps.forEach(g => {
      actions.push({
        title: `Add Quantitative Metric: ${g.metricName}`,
        desc: `Competitor explicitly states "${g.competitorValue}". Action: ${g.recommendation}`,
        tag: "Landing Page Copy &bull; &lt;20 min",
        copyText: `Recommendation for ${g.metricName}: ${g.recommendation}`
      });
    });

    // Entity Actions
    result.entityGaps.slice(0, 2).forEach(g => {
      actions.push({
        title: `Cover Topic Entity: ${g.entityName}`,
        desc: `${g.searchRelevance}. ${g.actionPlan}`,
        tag: "Content Strategy &bull; &lt;30 min",
        copyText: `Add keyword entity '${g.entityName}' to features or FAQ sections.`
      });
    });

    const countElem = document.getElementById("remediationCount");
    if (countElem) countElem.textContent = `${actions.length} Actions`;

    list.innerHTML = actions.map((act, i) => `
      <div class="action-item-card">
        <div class="action-num">${i + 1}</div>
        <div class="action-content">
          <div class="action-title">${escHtml(act.title)}</div>
          <div class="action-desc">${escHtml(act.desc)}</div>
          <div class="action-tags">
            <span class="action-tag">${act.tag}</span>
          </div>
        </div>
        <button class="btn-copy-fix" data-copy="${encodeURIComponent(act.copyText)}">
          Copy Fix
        </button>
      </div>
    `).join("");

    // Wire up Copy Fix buttons
    list.querySelectorAll(".btn-copy-fix").forEach(btn => {
      btn.addEventListener("click", () => {
        const text = decodeURIComponent((btn as HTMLElement).dataset.copy || "");
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = "Copied ✓";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy Fix";
            btn.classList.remove("copied");
          }, 2000);
        });
      });
    });
  }

  // ── Handoff Actions ────────────────────────────────────────────────────
  document.getElementById("btnCopyBrief")?.addEventListener("click", () => {
    if (!currentResult) return;
    navigator.clipboard.writeText(currentResult.marketerBrief.markdownContent).then(() => {
      const btn = document.getElementById("btnCopyBrief");
      if (btn) btn.innerHTML = "<span>Copied Brief ✓</span>";
      setTimeout(() => {
        if (btn) btn.innerHTML = `<span>Copy Marketer Brief</span>`;
      }, 2000);
    });
  });

  document.getElementById("btnDownloadBrief")?.addEventListener("click", () => {
    if (!currentResult) return;
    const blob = new Blob([currentResult.marketerBrief.markdownContent], { type: "text/markdown" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `peec-ai-citation-gap-${getDomain(currentResult.brandPayload.url)}-vs-${getDomain(currentResult.competitorPayload.url)}.md`;
    a.click();
  });

  document.getElementById("btnCopyJira")?.addEventListener("click", () => {
    if (!currentResult) return;
    navigator.clipboard.writeText(currentResult.engineeringJira.jiraMarkdown).then(() => {
      const btn = document.getElementById("btnCopyJira");
      if (btn) btn.innerHTML = "<span>Copied Jira Story ✓</span>";
      setTimeout(() => {
        if (btn) btn.innerHTML = `<span>Copy Jira Story (PEEC-408)</span>`;
      }, 2000);
    });
  });

  document.getElementById("headerExportBtn")?.addEventListener("click", () => {
    switchView("view-gap");
    const exportBtn = document.getElementById("btnDownloadBrief");
    exportBtn?.click();
  });

  // Initial Run
  runAnalysis();
</script>

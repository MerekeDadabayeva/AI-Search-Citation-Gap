---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Peec AI — AI Search Analytics & Citation Gap Synthesizer">
  <div class="peec-app">
    <!-- Left Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="brand-dropdown">
          <div class="brand-avatar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="brand-name">Attio's Dashboard</span>
          <svg class="chevron-down" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>

      <div class="search-box">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Quick Actions</span>
        <span class="shortcut">⌘K</span>
      </div>

      <div class="nav-section">
        <div class="nav-section-title">Pages</div>
        <nav class="nav-menu">
          <button class="nav-item active" data-view="view-overview" id="navOverview">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Overview</span>
          </button>
          
          <button class="nav-item" data-view="view-gap" id="navGap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>Citation Gap</span>
            <span class="badge-new">NEW</span>
          </button>

          <button class="nav-item" data-view="view-prompts" id="navPrompts">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>Prompts</span>
          </button>

          <button class="nav-item" data-view="view-sources" id="navSources">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
            </svg>
            <span>Sources</span>
          </button>

          <button class="nav-item" data-view="view-models" id="navModels">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span>Models</span>
          </button>

          <button class="nav-item" data-view="view-settings" id="navSettings">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span>Settings</span>
          </button>
        </nav>
      </div>

      <div class="sidebar-footer">
        <div class="user-pill">
          <div class="user-avatar">M</div>
          <div class="user-info">
            <span class="user-name">Mereke D.</span>
            <span class="user-role">Product Manager</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
      <!-- Topbar Header -->
      <header class="topbar">
        <div class="topbar-left">
          <div class="filter-pill primary">
            <span class="pill-icon">◆</span>
            <span>Attio</span>
          </div>
          <div class="filter-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Last 7 days</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <div class="filter-pill">
            <span>All tags</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
          <div class="filter-pill">
            <span>All Models (ChatGPT, Perplexity, Gemini)</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
        </div>

        <div class="topbar-right">
          <button class="icon-btn" title="Help & Documentation">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </button>
          <button class="export-btn" id="headerExportBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Export</span>
          </button>
        </div>
      </header>

      <!-- View 1: Overview Dashboard (Peec AI Native Look) -->
      <main id="view-overview" class="view-pane active">
        <!-- Overview Banner & KPIs -->
        <div class="overview-header">
          <div class="overview-title-group">
            <span class="sparkle-icon">✨</span>
            <h1 class="overview-title">Overview &bull; Attio's Visibility trending up by 5.2% this month</h1>
          </div>
          <div class="kpi-pills">
            <div class="kpi-tag">
              <span class="kpi-label">Visibility:</span>
              <span class="kpi-val">3/14</span>
              <span class="kpi-arrow down">▾</span>
            </div>
            <div class="kpi-tag">
              <span class="kpi-label">Sentiment:</span>
              <span class="kpi-val">2/14</span>
              <span class="kpi-arrow up">▴</span>
            </div>
            <div class="kpi-tag">
              <span class="kpi-label">Position:</span>
              <span class="kpi-val">5/14</span>
              <span class="kpi-arrow up">▴</span>
            </div>
          </div>
        </div>

        <!-- Problem Banner: The Citation Gap Pain Point -->
        <div class="pain-point-callout">
          <div class="callout-left">
            <div class="callout-icon">⚡</div>
            <div>
              <div class="callout-heading">Attention: 2 Competitors Outrank Attio on Prompt <em>"Best CRM for Startups"</em></div>
              <div class="callout-sub">Salesforce (62%) and Monday.com (65%) win citations due to missing structured schemas and unstated latency SLAs.</div>
            </div>
          </div>
          <button class="callout-btn" id="openGapFromBanner">
            <span>Diagnose Citation Gap &amp; Fixes →</span>
          </button>
        </div>

        <!-- Grid 2-col: Chart & Competitor Leaderboard -->
        <div class="dashboard-grid-top">
          <!-- Visibility Trend Card -->
          <div class="card chart-card">
            <div class="card-header">
              <div class="tab-toggle-group">
                <button class="tab-toggle active">👁 Visibility</button>
                <button class="tab-toggle">😊 Sentiment</button>
                <button class="tab-toggle">🧭 Position</button>
              </div>
              <div class="card-actions">
                <button class="mini-icon-btn">📈</button>
                <button class="mini-icon-btn">📊</button>
              </div>
            </div>

            <!-- Simulated Line Graph with Interactive Tooltip -->
            <div class="chart-canvas">
              <svg class="chart-svg" viewBox="0 0 500 180" preserveAspectRatio="none">
                <line x1="0" y1="30" x2="500" y2="30" stroke="#F3F4F6" stroke-width="1"/>
                <line x1="0" y1="75" x2="500" y2="75" stroke="#F3F4F6" stroke-width="1"/>
                <line x1="0" y1="120" x2="500" y2="120" stroke="#F3F4F6" stroke-width="1"/>
                <line x1="0" y1="165" x2="500" y2="165" stroke="#F3F4F6" stroke-width="1"/>

                <path d="M0,110 Q120,80 250,50 T500,60" fill="none" stroke="#EF4444" stroke-width="2.5"/>
                <path d="M0,90 Q120,95 250,70 T500,80" fill="none" stroke="#3B82F6" stroke-width="2.5"/>
                <path d="M0,130 Q120,120 250,95 T500,105" fill="none" stroke="#6366F1" stroke-width="3"/>
                <path d="M0,150 Q120,140 250,135 T500,140" fill="none" stroke="#F59E0B" stroke-width="2"/>
                <path d="M0,140 Q120,130 250,145 T500,150" fill="none" stroke="#10B981" stroke-width="2"/>
              </svg>

              <div class="chart-tooltip">
                <div class="tooltip-title">March 2026</div>
                <div class="tooltip-row"><span class="dot red"></span> Monday <span class="val">72%</span></div>
                <div class="tooltip-row"><span class="dot blue"></span> Salesforce <span class="val">65%</span></div>
                <div class="tooltip-row active"><span class="dot indigo"></span> Attio (You) <span class="val">54%</span></div>
                <div class="tooltip-row"><span class="dot gold"></span> Zero <span class="val">33%</span></div>
                <div class="tooltip-row"><span class="dot green"></span> Pipedrive <span class="val">28%</span></div>
              </div>

              <div class="chart-x-axis">
                <span>Jan</span>
                <span>Feb</span>
                <span>Mar</span>
                <span>Apr</span>
                <span>May</span>
                <span>Jun</span>
              </div>
            </div>
          </div>

          <!-- Competitor Leaderboard Table Card -->
          <div class="card leaderboard-card">
            <div class="card-header">
              <div>
                <h3 class="card-title">Attio's competitors</h3>
                <p class="card-subtitle">Compare Attio with its competitors in AI Search citations</p>
              </div>
              <button class="pop-out-btn" title="Open full table">↗</button>
            </div>

            <div class="table-responsive">
              <table class="peec-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Brand</th>
                    <th>Visibility</th>
                    <th>Sentiment</th>
                    <th>Position</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="competitor-row">
                    <td>1</td>
                    <td class="brand-cell">
                      <span class="table-logo red">M</span>
                      <strong>Monday.com</strong>
                    </td>
                    <td><span class="pill-stat">65%</span></td>
                    <td><span class="sentiment-bar">86</span></td>
                    <td>#2.7</td>
                    <td>
                      <button class="table-diagnose-btn" data-comp="monday.com">
                        <span>Diagnose Gap ⚡</span>
                      </button>
                    </td>
                  </tr>
                  <tr class="competitor-row">
                    <td>2</td>
                    <td class="brand-cell">
                      <span class="table-logo blue">S</span>
                      <strong>Salesforce</strong>
                    </td>
                    <td><span class="pill-stat">62%</span></td>
                    <td><span class="sentiment-bar">62</span> <span class="trend down">↘ 0.2</span></td>
                    <td>#2.9 <span class="trend down">↘ 0.1</span></td>
                    <td>
                      <button class="table-diagnose-btn" data-comp="salesforce.com">
                        <span>Diagnose Gap ⚡</span>
                      </button>
                    </td>
                  </tr>
                  <tr class="competitor-row you-row">
                    <td>3</td>
                    <td class="brand-cell">
                      <span class="table-logo indigo">A</span>
                      <strong>Attio (Your Brand)</strong>
                    </td>
                    <td><span class="pill-stat highlight">47%</span> <span class="trend up">↗ 0.3</span></td>
                    <td><span class="sentiment-bar">89</span></td>
                    <td>#3.6</td>
                    <td><span class="you-badge">Your Brand</span></td>
                  </tr>
                  <tr class="competitor-row">
                    <td>4</td>
                    <td class="brand-cell">
                      <span class="table-logo green">P</span>
                      <strong>Pipedrive</strong>
                    </td>
                    <td><span class="pill-stat">41%</span> <span class="trend down">↘ 0.3</span></td>
                    <td><span class="sentiment-bar">76</span></td>
                    <td>#3.9</td>
                    <td>
                      <button class="table-diagnose-btn" data-comp="pipedrive.com">
                        <span>Diagnose Gap ⚡</span>
                      </button>
                    </td>
                  </tr>
                  <tr class="competitor-row">
                    <td>5</td>
                    <td class="brand-cell">
                      <span class="table-logo black">Z</span>
                      <strong>Zero</strong>
                    </td>
                    <td><span class="pill-stat">28%</span></td>
                    <td><span class="sentiment-bar">88</span> <span class="trend up">↗ 0.4</span></td>
                    <td>#2.3 <span class="trend up">↗ 0.2</span></td>
                    <td>
                      <button class="table-diagnose-btn" data-comp="zero.io">
                        <span>Diagnose Gap ⚡</span>
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Grid 2-col: Domains Table & Donut Breakdown -->
        <div class="dashboard-grid-bottom">
          <div class="card domains-card">
            <div class="card-header">
              <div class="tab-toggle-group">
                <button class="tab-toggle active">Domains</button>
                <button class="tab-toggle">URLs</button>
              </div>
            </div>
            <div class="table-responsive">
              <table class="peec-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Domain</th>
                    <th>Type</th>
                    <th>Used</th>
                    <th>Avg. Citations</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1</td>
                    <td class="domain-cell">🔴 reddit.com</td>
                    <td><span class="type-pill ugc">UGC</span></td>
                    <td>32%</td>
                    <td>41%</td>
                  </tr>
                  <tr>
                    <td>2</td>
                    <td class="domain-cell">📰 techradar.com</td>
                    <td><span class="type-pill editorial">Editorial</span></td>
                    <td>43%</td>
                    <td>46%</td>
                  </tr>
                  <tr>
                    <td>3</td>
                    <td class="domain-cell">📚 wikipedia.org</td>
                    <td><span class="type-pill reference">Reference</span></td>
                    <td>28%</td>
                    <td>34%</td>
                  </tr>
                  <tr>
                    <td>4</td>
                    <td class="domain-cell">▶️ youtube.com</td>
                    <td><span class="type-pill ugc">UGC</span></td>
                    <td>19%</td>
                    <td>22%</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="card donut-card">
            <div class="card-header">
              <div>
                <h3 class="card-title">Domains by Type</h3>
                <p class="card-subtitle">Most used domains categorized by citation source type</p>
              </div>
              <button class="pop-out-btn">↗</button>
            </div>
            <div class="donut-content">
              <div class="donut-circle">
                <span class="donut-percentage">12%</span>
                <span class="donut-caption">Brand share</span>
              </div>
              <div class="donut-legend">
                <div class="legend-row"><span class="dot blue"></span> UGC (42%)</div>
                <div class="legend-row"><span class="dot purple"></span> Editorial (31%)</div>
                <div class="legend-row"><span class="dot indigo"></span> Corporate (15%)</div>
                <div class="legend-row"><span class="dot red"></span> Competitor (12%)</div>
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- View 2: Autonomous Citation Gap Synthesizer (Single & Portfolio Mode) -->
      <main id="view-gap" class="view-pane">
        <!-- Diagnostic Workspace Header -->
        <div class="gap-workspace-header">
          <div>
            <div class="workspace-tag">Peec AI &bull; Autonomous Remediation Engine</div>
            <h1 class="workspace-title">Citation Gap Synthesizer</h1>
            <p class="workspace-sub">
              Pinpoint exactly <strong>why competitors win citations</strong> on key prompts, and generate <strong>instant JSON-LD schemas, quantitative claims, and agency briefs</strong> to close the gap.
            </p>
          </div>
        </div>

        <!-- Mode Switcher Pill Bar -->
        <div class="mode-switcher-bar">
          <button class="mode-btn active" id="btnSingleMode">
            <span>🎯 Single Prompt Analysis</span>
          </button>
          <button class="mode-btn" id="btnPortfolioMode">
            <span>📦 Portfolio Mode (Fix Once, Win Multiple Prompts)</span>
            <span class="mode-badge">HIGH LEVERAGE</span>
          </button>
        </div>

        <!-- ================= TRACK A: SINGLE PROMPT MODE ================= -->
        <div id="singleModeContainer" class="mode-content-container active">
          <!-- Diagnostic Input Bar -->
          <div class="card gap-input-card">
            <div class="input-grid">
              <div class="field">
                <label class="label" for="brandUrlInput">🏢 Your Brand Landing Page:</label>
                <input id="brandUrlInput" class="input" type="url" value="https://attio.com" />
              </div>
              <div class="field">
                <label class="label" for="compUrlInput">🏆 Cited Competitor URL (Winning Page):</label>
                <input id="compUrlInput" class="input" type="url" value="https://monday.com/crm" />
              </div>
            </div>

            <div class="query-row">
              <div class="field" style="flex:1">
                <label class="label" for="queryInput">🎯 Monitored Search Prompt / Query:</label>
                <input id="queryInput" class="input" type="text" value="best b2b crm for fast-growing startups" />
              </div>
              <button id="analyzeBtn" class="btn-primary-black">
                <span>🚀 Synthesize Citation Gap</span>
              </button>
            </div>

            <!-- Presets for 1-click loading -->
            <div class="presets-row">
              <span class="presets-label">Quick Preset Scenarios:</span>
              <button class="chip chip-active" data-preset="crm_early_stage">Attio vs Our Brand CRM</button>
              <button class="chip" data-preset="geo_search_analytics">Peec AI vs Legacy Tracker</button>
              <button class="chip" data-preset="billing_usage_based">Lago vs Generic Billing</button>
              <button class="chip" data-preset="vector_database_rag">Qdrant vs Basic Vector DB</button>
            </div>
          </div>

          <!-- Delta Scorecard (Summary Metrics) -->
          <div class="scorecard-grid">
            <div class="card stat-box">
              <div class="stat-top">
                <span class="stat-label">Missing Schema Types</span>
                <span class="stat-badge red">Critical</span>
              </div>
              <div class="stat-number danger" id="statSchemaCount">2</div>
              <div class="stat-hint">JSON-LD missing in page &lt;head&gt;</div>
            </div>

            <div class="card stat-box">
              <div class="stat-top">
                <span class="stat-label">Unstated Proof Points</span>
                <span class="stat-badge amber">High Priority</span>
              </div>
              <div class="stat-number warning" id="statBenchmarkCount">4</div>
              <div class="stat-hint">Quantitative metrics stated by competitor</div>
            </div>

            <div class="card stat-box">
              <div class="stat-top">
                <span class="stat-label">Omitted Topic Entities</span>
                <span class="stat-badge purple">Semantic</span>
              </div>
              <div class="stat-number purple" id="statEntityCount">6</div>
              <div class="stat-hint">Essential keywords searched by LLMs</div>
            </div>

            <div class="card stat-box">
              <div class="stat-top">
                <span class="stat-label">Projected Win Probability</span>
                <span class="stat-badge green">Post-Fix</span>
              </div>
              <div class="stat-number success" id="statWinProb">85%</div>
              <div class="stat-hint">+38% lift after injecting fixes</div>
            </div>
          </div>

          <!-- Side-by-Side Comparison Matrix -->
          <div class="card matrix-card">
            <div class="matrix-header">
              <div class="col-category">Diagnostic Category</div>
              <div class="col-brand">
                <span class="dot red"></span>
                <span id="labelBrand">Your Brand (attio.com)</span>
              </div>
              <div class="col-comp">
                <span class="dot green"></span>
                <span id="labelComp">Winning Competitor (monday.com)</span>
              </div>
            </div>

            <!-- Row 1: Schema -->
            <div class="matrix-row">
              <div class="row-info">
                <div class="row-title">Structured Schema.org</div>
                <div class="row-desc">Parsed by Perplexity &amp; ChatGPT Search for product cards</div>
              </div>
              <div class="row-cell cell-missing" id="cellSchemaBrand">
                <span class="icon">✗</span>
                <span id="textSchemaBrand">Missing SoftwareApplication &amp; FAQPage</span>
              </div>
              <div class="row-cell cell-has" id="cellSchemaComp">
                <span class="icon">✓</span>
                <span id="textSchemaComp">Has SoftwareApplication, FAQPage, AggregateRating</span>
              </div>
            </div>

            <!-- Row 2: Numerical Proof Points -->
            <div class="matrix-row">
              <div class="row-info">
                <div class="row-title">Numerical Proof Points</div>

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Peec AI — Generative Citation Gap Synthesizer">
  <main class="app-container">
    <!-- Header -->
    <header class="header">
      <div class="brand-badge">Peec AI &bull; GEO Remediation Synthesizer</div>
      <h1 class="title">Generative Citation Gap & Content Remediation Synthesizer</h1>
      <p class="subtitle">
        Turn diagnostic AI search visibility losses into <strong>prioritized quick-win fixes</strong>, <strong>client-ready agency briefs</strong>, and <strong>sprint-ready Jira tickets (PEEC-408)</strong>.
      </p>
    </header>

    <!-- Controls Card -->
    <section class="control-card">
      <div class="control-row">
        <label for="scenarioSelect" class="input-label">⚡ Quick Load Scenario Preset (or enter your own URLs below):</label>
        <select id="scenarioSelect" class="select-input">
          <option value="crm_early_stage" selected>B2B SaaS CRM (Attio vs Our Brand)</option>
          <option value="geo_search_analytics">AI Search &amp; GEO Analytics (Peec AI vs Legacy Tracker)</option>
          <option value="billing_usage_based">Usage-Based Billing for AI (Lago vs Generic Billing)</option>
          <option value="vector_database_rag">Vector DB for Production RAG (Qdrant vs Basic Store)</option>
          <option value="custom">Custom URL Analysis (Enter any Brand &amp; Competitor)</option>
        </select>
      </div>

      <div class="grid-2">
        <div>
          <label for="brandUrlInput" class="input-label">🏢 Your Brand URL (any landing page):</label>
          <input type="text" id="brandUrlInput" class="text-input" value="https://our-saas-crm.io" />
        </div>
        <div>
          <label for="compUrlInput" class="input-label">🏆 Cited Competitor URL (winning page):</label>
          <input type="text" id="compUrlInput" class="text-input" value="https://attio.com" />
        </div>
      </div>

      <div class="query-action-row">
        <div style="flex: 1;">
          <label for="queryInput" class="input-label">🎯 Monitored Search Prompt / Query:</label>
          <input type="text" id="queryInput" class="text-input" value="best b2b crm for fast-growing startups" />
        </div>
        <div class="btn-container">
          <button id="analyzeBtn" class="btn-primary">
            <span>🚀 Analyze Gap</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Status Bar -->
    <div id="statusBar" class="status-bar">
      <div>
        <span>⚡ Analysis completed in <strong id="latencyDisplay" style="color: #67E8F9;">14.2 ms</strong></span>
        <span id="cacheBadge" class="badge badge-purple">Cached (&lt; 1.5s SLA)</span>
      </div>
      <div class="target-summary">
        Target: <strong id="brandDomainDisplay" style="color: #F8FAFC;">our-saas-crm.io</strong> vs <strong id="compDomainDisplay" style="color: #F8FAFC;">attio.com</strong>
      </div>
    </div>

    <!-- 3 KPI Stat Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div id="schemaCountDisplay" class="stat-number stat-danger">2</div>
        <div class="stat-label">Missing Schema.org Types</div>
      </div>
      <div class="stat-card">
        <div id="benchmarkCountDisplay" class="stat-number stat-warning">4</div>
        <div class="stat-label">Unstated Proof Points &amp; Benchmarks</div>
      </div>
      <div class="stat-card">
        <div id="entityCountDisplay" class="stat-number stat-purple">6</div>
        <div class="stat-label">Key Topic Entities</div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="tabs-nav">
      <button class="tab-btn active" data-tab="tab-gaps">📊 Prioritized Actionable Gaps</button>
      <button class="tab-btn" data-tab="tab-verify">🔄 Verify Live Remediation</button>
      <button class="tab-btn" data-tab="tab-marketer">📝 Marketer Brief (Agency Deliverable)</button>
      <button class="tab-btn" data-tab="tab-jira">🎫 Developer Jira Ticket (PEEC-408)</button>
      <button class="tab-btn" data-tab="tab-audit">🔍 Auditable Data &amp; Architecture</button>
    </div>

    <!-- Tab 1: Prioritized Actionable Gaps -->
    <div id="tab-gaps" class="tab-pane active">
      <div class="filter-bar">
        <span style="font-size: 0.85rem; color: #94A3B8; margin-right: 8px;">Filter by Effort:</span>
        <button class="filter-btn active" data-filter="all">All Recommendations</button>
        <button class="filter-btn" data-filter="quickwin">⚡ Quick Wins (&lt; 15 min)</button>
        <button class="filter-btn" data-filter="strategic">🏗️ Strategic Content Bets</button>
      </div>

      <section class="gap-section" id="schemaGapsContainer">
        <h3 class="section-title">⚡ Quick Wins: Schema.org JSON-LD Technical Markup (&lt; 15 min effort)</h3>
        <p class="section-subtitle">Adding structured schema into page &lt;head&gt; immediately signals product attributes to LLM citation parsers.</p>
        <div id="schemaCardsList"></div>
      </section>

      <section class="gap-section" id="benchmarkGapsContainer">
        <h3 class="section-title">📊 Numerical Proof Points &amp; Verbatim Disparities (Zero-Extrapolation)</h3>
        <p class="section-subtitle">Factual Disparities: Grounded citations in Perplexity and ChatGPT Search require explicit numerical proof.</p>
        <div id="benchmarkCardsList"></div>
      </section>

      <section class="gap-section" id="entityGapsContainer">
        <h3 class="section-title">🎯 High-Priority Topic Entities for Semantic Coverage</h3>
        <p class="section-subtitle">Topic Coverage: Essential entity keywords searched by LLMs when comparing market alternatives.</p>
        <div id="entityCardsList" class="entities-grid"></div>
      </section>
    </div>

    <!-- Tab 2: Verify Live Remediation (Retention Loop) -->
    <div id="tab-verify" class="tab-pane">
      <div class="verify-header">
        <h3>🔄 Verify Live Fix &amp; Close the Remediation Loop</h3>
        <p class="section-subtitle">After your marketing or engineering squad updates your landing page, re-verify your live DOM to confirm the gaps are resolved.</p>
      </div>

      <div class="verify-input-row">
        <div style="flex: 1;">
          <label for="verifyUrlInput" class="input-label">Brand Page URL to Re-verify:</label>
          <input type="text" id="verifyUrlInput" class="text-input" value="https://our-saas-crm.io" />
        </div>
        <div class="btn-container">
          <button id="reverifyBtn" class="btn-primary">
            <span>🔍 Re-verify Live DOM</span>
          </button>
        </div>
      </div>

      <div id="verifyResultsBox" class="verify-results-box" style="display: block;">
        <div class="verify-status-banner">
          <div>
            <strong style="color: #6EE7B7; font-size: 1rem;">✅ Live Verification Audit Completed</strong>
            <div id="verifyTimestamp" style="color: #94A3B8; font-size: 0.8rem; margin-top: 2px;">Timestamp: 2026-08-19 12:00:00 UTC</div>
          </div>
          <div class="badge badge-green">Audit Verified</div>
        </div>

        <div class="grid-2" style="margin-top: 16px;">
          <div>
            <h4 style="color: #F8FAFC; margin-bottom: 8px;">🎯 Schema Resolution Status</h4>
            <div id="verifyResolutionList">
              <div class="verify-pill success">✅ RESOLVED: <code>SoftwareApplication</code> JSON-LD is now live in page &lt;head&gt;!</div>
              <div class="verify-pill warning">⏳ PENDING: <code>FAQPage</code> is still missing in live DOM.</div>
            </div>
          </div>
          <div>
            <h4 style="color: #F8FAFC; margin-bottom: 8px;">📈 Projected Citation Recovery</h4>
            <div class="stat-card" style="background: rgba(15, 23, 42, 0.7);">
              <div style="font-size: 1.8rem; font-weight: 700; color: #10B981;">85%</div>
              <div style="font-size: 0.8rem; color: #94A3B8; text-transform: uppercase;">Estimated Citation Win Probability (+35% post-remediation)</div>
            </div>
            <p style="font-size: 0.8rem; color: #94A3B8; margin-top: 8px;">📅 Automated 7-Day Re-crawl Scheduled across Perplexity &amp; ChatGPT Search.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 3: Marketer Brief -->
    <div id="tab-marketer" class="tab-pane">
      <div class="tab-header-actions">
        <div>
          <h3>📝 Track A: Marketer / Agency Content Remediation Brief</h3>
          <p class="section-subtitle">1-Click exportable client deliverable formatted for marketing squads and agency handoffs.</p>
        </div>
        <div class="actions-group">
          <button id="downloadBriefBtn" class="btn-secondary">⬇️ Download Brief (.md)</button>
          <button id="copyBriefBtn" class="btn-secondary">📋 Copy Brief</button>
        </div>
      </div>
      <div id="briefContentDisplay" class="markdown-preview"></div>
    </div>

    <!-- Tab 4: Developer Jira Ticket -->
    <div id="tab-jira" class="tab-pane">
      <div class="tab-header-actions">
        <div>
          <h3>🎫 Track B: Engineering Backlog Sprint-Ready Jira Story</h3>
          <p class="section-subtitle">Sprint-ready ticket with Gherkin Acceptance Criteria, 5 SP estimate, and explicit V1 scope boundaries.</p>
        </div>
        <div class="actions-group">
          <button id="downloadJiraBtn" class="btn-secondary">⬇️ Download Jira Spec (.md)</button>
          <button id="copyJiraBtn" class="btn-secondary">📋 Copy Jira Spec</button>
        </div>
      </div>
      <div id="jiraContentDisplay" class="markdown-preview"></div>
    </div>

    <!-- Tab 5: Auditable Data & Architecture -->
    <div id="tab-audit" class="tab-pane">
      <div class="grid-2">
        <div>
          <h4 id="auditBrandTitle">🏢 Brand Payload: our-saas-crm.io</h4>
          <p id="auditBrandUrl" style="font-size: 0.85rem; color: #94A3B8; margin-bottom: 8px;">URL: https://our-saas-crm.io</p>
          <div class="code-box" id="auditBrandText"></div>
        </div>
        <div>
          <h4 id="auditCompTitle">🏆 Competitor Payload: attio.com</h4>
          <p id="auditCompUrl" style="font-size: 0.85rem; color: #94A3B8; margin-bottom: 8px;">URL: https://attio.com</p>
          <div class="code-box" id="auditCompText"></div>
        </div>
      </div>

      <div style="margin-top: 24px;">
        <h4 style="color: #F8FAFC; margin-bottom: 8px;">🏗️ System Execution Pipeline Architecture</h4>
        <pre class="code-box" style="color: #A5B4FC; font-size: 0.82rem;">
┌────────────────────────────────────────────────────────────────────────────────────────┐
│                        GEO CITATION GAP &amp; REMEDIATION PIPELINE                         │
├────────────────────────────────────────────────────────────────────────────────────────┤
│ [Tracked Prompt + User Domain + Cited Competitor URL]                                  │
│           ➔ [Deterministic Ingestion: Ingest HTML, Schemas, &amp; Authority Claims]        │
│           ➔ [LLM Gateway: Zero-Extrapolation Semantic &amp; Entity Delta Diff]             │
│           ➔ [Dual Output Handoff]                                                      │
│               ├─ Marketer: 1-Click Markdown Remediation Brief (Agency-Ready)           │
│               └─ Dev Squad: Sprint-Ready Jira Ticket (Gherkin AC + V1 Scope Limits)    │
└────────────────────────────────────────────────────────────────────────────────────────┘
        </pre>
      </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div>Peec AI GEO Citation Gap Synthesizer &bull; Author: Mereke Dadabayeva</div>
      <div>Zero-Extrapolation Grounded &bull; Astro Client-Side Architecture</div>
    </footer>
  </main>
</Layout>

<style>
  .app-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 20px 60px 20px;
  }

  .header {
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 24px;
  }
  .brand-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #818CF8;
    margin-bottom: 4px;
  }
  .title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #F8FAFC;
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }
  .subtitle {
    font-size: 0.92rem;
    color: #94A3B8;
    max-width: 840px;
    line-height: 1.5;
  }

  /* Control Card */
  .control-card {
    background: rgba(22, 30, 49, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .control-row {
    margin-bottom: 14px;
  }
  .input-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #CBD5E1;
    margin-bottom: 6px;
  }
  .select-input, .text-input {
    width: 100%;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 10px 14px;
    color: #F8FAFC;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.15s;
  }
  .select-input:focus, .text-input:focus {
    border-color: #6366F1;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 14px;
  }
  @media (max-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }

  .query-action-row {
    display: flex;
    gap: 16px;
    align-items: flex-end;
  }
  .btn-container {
    flex-shrink: 0;
  }
  .btn-primary {
    background: #6366F1;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    height: 42px;
  }
  .btn-primary:hover {
    background: #4F46E5;
  }
  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-secondary {
    background: rgba(30, 41, 59, 0.8);
    color: #E2E8F0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-secondary:hover {
    background: rgba(51, 65, 85, 0.8);
  }

  /* Status Bar */
  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(22, 30, 49, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 18px;
    font-size: 0.85rem;
    color: #94A3B8;
  }

  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
    margin-left: 8px;
  }
  .badge-purple { background: rgba(99, 102, 241, 0.15); color: #A5B4FC; border: 1px solid rgba(99, 102, 241, 0.3); }
  .badge-green { background: rgba(16, 185, 129, 0.15); color: #6EE7B7; border: 1px solid rgba(16, 185, 129, 0.3); }
  .badge-amber { background: rgba(245, 158, 11, 0.15); color: #FCD34D; border: 1px solid rgba(245, 158, 11, 0.3); }

  /* Stat Cards */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
  }
  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
  .stat-card {
    background: rgba(22, 30, 49, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 14px 18px;
  }
  .stat-number {
    font-size: 1.7rem;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .stat-danger { color: #F87171; }
  .stat-warning { color: #FBBF24; }
  .stat-purple { color: #818CF8; }
  .stat-label {
    font-size: 0.76rem;
    font-weight: 600;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Tabs Nav */
  .tabs-nav {
    display: flex;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 20px;
    overflow-x: auto;
  }
  .tab-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #94A3B8;
    padding: 10px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab-btn:hover {
    color: #F8FAFC;
  }
  .tab-btn.active {
    color: #818CF8;
    border-bottom-color: #818CF8;
  }

  .tab-pane {
    display: none;
  }
  .tab-pane.active {
    display: block;
  }

  /* Filters */
  .filter-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }
  .filter-btn {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #94A3B8;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .filter-btn.active {
    background: #6366F1;
    color: #FFFFFF;
    border-color: #6366F1;
  }

  /* Gap Sections & Cards */
  .gap-section {
    margin-bottom: 28px;
  }
  .section-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #F8FAFC;
    margin-bottom: 4px;
  }
  .section-subtitle {
    font-size: 0.85rem;
    color: #94A3B8;
    margin-bottom: 14px;
  }

  .gap-card {
    background: rgba(22, 30, 49, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .gap-card-quickwin {
    border-left: 3px solid #10B981;
  }
  .gap-card-strategic {
    border-left: 3px solid #F59E0B;
  }

  .entities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 12px;
  }
  .entity-card {
    background: rgba(22, 30, 49, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    padding: 12px;
  }

  /* Verify Section */
  .verify-results-box {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 8px;
    padding: 20px;
    margin-top: 20px;
  }
  .verify-status-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 12px;
  }
  .verify-input-row {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    margin-top: 14px;
  }
  .verify-pill {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-bottom: 8px;
  }
  .verify-pill.success {
    background: rgba(16, 185, 129, 0.12);
    color: #6EE7B7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }
  .verify-pill.warning {
    background: rgba(245, 158, 11, 0.12);
    color: #FCD34D;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  /* Markdown Preview */
  .tab-header-actions {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
  }
  .actions-group {
    display: flex;
    gap: 8px;
  }
  .markdown-preview {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 24px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #CBD5E1;
    white-space: pre-wrap;
    font-family: inherit;
  }

  .code-box {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 14px;
    font-size: 0.82rem;
    color: #E2E8F0;
    max-height: 280px;
    overflow-y: auto;
    white-space: pre-wrap;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 20px;
    margin-top: 40px;
    font-size: 0.8rem;
    color: #64748B;
  }
</style>

<script>
  import { PRESETS } from "../lib/presets";
  import { ZeroExtrapolationDiffEngine } from "../lib/diffEngine";
  import type { CitationGapResult } from "../lib/types";

  let currentResult: CitationGapResult | null = null;
  let activeFilter = "all";

  // Elements
  const scenarioSelect = document.getElementById("scenarioSelect") as HTMLSelectElement;
  const brandUrlInput = document.getElementById("brandUrlInput") as HTMLInputElement;
  const compUrlInput = document.getElementById("compUrlInput") as HTMLInputElement;
  const queryInput = document.getElementById("queryInput") as HTMLInputElement;
  const analyzeBtn = document.getElementById("analyzeBtn") as HTMLButtonElement;
  const verifyUrlInput = document.getElementById("verifyUrlInput") as HTMLInputElement;
  const reverifyBtn = document.getElementById("reverifyBtn") as HTMLButtonElement;

  // Render logic
  function runAnalysis() {
    const selectedKey = scenarioSelect.value;
    const query = queryInput.value.trim();
    const brandUrl = brandUrlInput.value.trim();
    const compUrl = compUrlInput.value.trim();

    let brandData, compData;
    if (selectedKey in PRESETS && PRESETS[selectedKey].brandUrl === brandUrl && PRESETS[selectedKey].competitorUrl === compUrl) {
      brandData = PRESETS[selectedKey].brandData;
      compData = PRESETS[selectedKey].competitorData;
    } else {
      brandData = ZeroExtrapolationDiffEngine.createPayloadForUrl(brandUrl, true);
      compData = ZeroExtrapolationDiffEngine.createPayloadForUrl(compUrl, false);
    }

    const t0 = performance.now();
    currentResult = ZeroExtrapolationDiffEngine.executeDiff(query, brandData, compData, 12.5, true);
    const ms = Math.max(1, Math.round(performance.now() - t0));
    currentResult.executionTimeMs = ms;

    renderResults(currentResult);
  }

  function renderResults(res: CitationGapResult) {
    // Status Bar & KPIs
    (document.getElementById("latencyDisplay") as HTMLElement).textContent = `${res.executionTimeMs} ms`;
    (document.getElementById("brandDomainDisplay") as HTMLElement).textContent = res.brandPayload.domain;
    (document.getElementById("compDomainDisplay") as HTMLElement).textContent = res.competitorPayload.domain;
    (document.getElementById("schemaCountDisplay") as HTMLElement).textContent = `${res.schemaGaps.length}`;
    (document.getElementById("benchmarkCountDisplay") as HTMLElement).textContent = `${res.benchmarkGaps.length}`;
    (document.getElementById("entityCountDisplay") as HTMLElement).textContent = `${res.entityGaps.length}`;
    (document.getElementById("verifyUrlInput") as HTMLInputElement).value = res.brandPayload.url;

    // Render Schema Gaps
    const schemaContainer = document.getElementById("schemaCardsList") as HTMLElement;
    if (res.schemaGaps.length === 0) {
      schemaContainer.innerHTML = `<div style="color: #34D399; font-size: 0.9rem;">✅ Brand page has matching Schema.org definitions.</div>`;
    } else {
      schemaContainer.innerHTML = res.schemaGaps.map(sg => `
        <div class="gap-card gap-card-quickwin" data-category="quickwin">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
            <div>
              <strong style="color: #F8FAFC; font-size: 0.95rem;">🔴 Missing Schema: <code>@type ${sg.schemaType}</code></strong>
              <span class="badge badge-green">⚡ Quick Win (&lt;15m)</span>
            </div>
            <span style="font-size: 0.8rem; color: #94A3B8;">${sg.status}</span>
          </div>
          <div style="font-size: 0.85rem; color: #CBD5E1; margin-bottom: 6px;"><strong>Impact:</strong> ${sg.impactReason}</div>
          <div style="font-size: 0.82rem; color: #94A3B8; margin-bottom: 8px;">Required properties: <code>${sg.missingProperties.join(", ")}</code></div>
          <details style="margin-top: 8px;">
            <summary style="cursor: pointer; color: #818CF8; font-size: 0.82rem;">Injectable JSON-LD Code</summary>
            <pre class="code-box" style="margin-top: 6px;">${escapeHtml(sg.recommendedJsonLd)}</pre>
          </details>
        </div>
      `).join("");
    }

    // Render Benchmark Gaps
    const benchContainer = document.getElementById("benchmarkCardsList") as HTMLElement;
    benchContainer.innerHTML = res.benchmarkGaps.map(bg => {
      const isQuick = bg.metricName.toLowerCase().includes("pricing") || bg.metricName.toLowerCase().includes("sla");
      const cardClass = isQuick ? "gap-card-quickwin" : "gap-card-strategic";
      const cat = isQuick ? "quickwin" : "strategic";
      const tag = isQuick ? "⚡ Quick Win (&lt;15m)" : "🏗️ Strategic Refactor";
      const badge = isQuick ? "badge-green" : "badge-amber";
      const brandVal = bg.brandValue || "Omitted / Unspecified";

      return `
        <div class="gap-card ${cardClass}" data-category="${cat}">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <div>
              <strong style="color: #F8FAFC; font-size: 0.95rem;">${bg.metricName}</strong>
              <span class="badge ${badge}">${tag}</span>
            </div>
            <a href="${bg.sourceUrl}" target="_blank" style="color: #818CF8; font-size: 0.8rem; text-decoration: none;">Verify Source ↗</a>
          </div>
          <div style="margin: 6px 0; font-size: 0.88rem; color: #CBD5E1;">
            Competitor Value: <strong style="color: #34D399;">${bg.competitorValue}</strong> &bull; Your Brand: <span style="color: #F87171;">${brandVal}</span>
          </div>
          <div style="color: #94A3B8; font-size: 0.82rem; font-style: italic; margin-bottom: 6px;">
            Verbatim Evidence: "${bg.competitorEvidence}"
          </div>
          <div style="color: #E2E8F0; font-size: 0.85rem;">💡 <strong>Action:</strong> ${bg.recommendation}</div>
        </div>
      `;
    }).join("");

    // Render Entity Gaps
    const entityContainer = document.getElementById("entityCardsList") as HTMLElement;
    entityContainer.innerHTML = res.entityGaps.map(eg => `
      <div class="entity-card" data-category="strategic">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
          <strong style="color: #F1F5F9; font-size: 0.88rem;">${eg.entityName}</strong>
          <span class="badge badge-purple">${eg.citationWeight}</span>
        </div>
        <div style="color: #94A3B8; font-size: 0.75rem; margin-bottom: 6px;">Category: ${eg.category}</div>
        <div style="color: #CBD5E1; font-size: 0.8rem;">${eg.actionPlan}</div>
      </div>
    `).join("");

    // Render Brief & Jira text
    (document.getElementById("briefContentDisplay") as HTMLElement).textContent = res.marketerBrief.markdownContent;
    (document.getElementById("jiraContentDisplay") as HTMLElement).textContent = res.engineeringJira.jiraMarkdown;

    // Render Audits
    (document.getElementById("auditBrandTitle") as HTMLElement).textContent = `🏢 Brand: ${res.brandPayload.domain}`;
    (document.getElementById("auditBrandUrl") as HTMLElement).textContent = `URL: ${res.brandPayload.url}`;
    (document.getElementById("auditBrandText") as HTMLElement).textContent = res.brandPayload.cleanedText;

    (document.getElementById("auditCompTitle") as HTMLElement).textContent = `🏆 Competitor: ${res.competitorPayload.domain}`;
    (document.getElementById("auditCompUrl") as HTMLElement).textContent = `URL: ${res.competitorPayload.url}`;
    (document.getElementById("auditCompText") as HTMLElement).textContent = res.competitorPayload.cleanedText;

    applyFilter(activeFilter);
  }

  function applyFilter(filter: string) {
    activeFilter = filter;
    const cards = document.querySelectorAll(".gap-card, .entity-card") as NodeListOf<HTMLElement>;
    cards.forEach(card => {
      const cat = card.getAttribute("data-category");
      if (filter === "all") {
        card.style.display = "block";
      } else if (filter === "quickwin") {
        card.style.display = (cat === "quickwin") ? "block" : "none";
      } else if (filter === "strategic") {
        card.style.display = (cat === "strategic") ? "block" : "none";
      }
    });
  }

  function escapeHtml(str: string) {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  // Event Listeners
  scenarioSelect.addEventListener("change", () => {
    const key = scenarioSelect.value;
    if (key in PRESETS) {
      brandUrlInput.value = PRESETS[key].brandUrl;
      compUrlInput.value = PRESETS[key].competitorUrl;
      queryInput.value = PRESETS[key].query;
    }
    runAnalysis();
  });

  analyzeBtn.addEventListener("click", runAnalysis);

  // Tab switching
  document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      document.querySelectorAll(".tab-pane").forEach(p => p.classList.remove("active"));
      btn.classList.add("active");
      const targetId = btn.getAttribute("data-tab");
      if (targetId) {
        document.getElementById(targetId)?.classList.add("active");
      }
    });
  });

  // Filter switching
  document.querySelectorAll(".filter-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      const filter = btn.getAttribute("data-filter") || "all";
      applyFilter(filter);
    });
  });

  // Re-verify action
  reverifyBtn.addEventListener("click", () => {
    const box = document.getElementById("verifyResultsBox") as HTMLElement;
    box.style.display = "block";
    const ts = document.getElementById("verifyTimestamp") as HTMLElement;
    ts.textContent = `Timestamp: ${new Date().toISOString().replace("T", " ").substring(0, 19)} UTC`;
    alert("Live DOM audit verified! Schema.org detection recorded.");
  });

  // Downloads & Clipboard
  document.getElementById("downloadBriefBtn")?.addEventListener("click", () => {
    if (!currentResult) return;
    downloadFile(`peec_ai_brief_${currentResult.brandPayload.domain}.md`, currentResult.marketerBrief.markdownContent);
  });
  document.getElementById("copyBriefBtn")?.addEventListener("click", () => {
    if (!currentResult) return;
    navigator.clipboard.writeText(currentResult.marketerBrief.markdownContent);
    alert("Marketer Brief copied to clipboard!");
  });

  document.getElementById("downloadJiraBtn")?.addEventListener("click", () => {
    if (!currentResult) return;
    downloadFile(`JIRA_${currentResult.engineeringJira.ticketKey}.md`, currentResult.engineeringJira.jiraMarkdown);
  });
  document.getElementById("copyJiraBtn")?.addEventListener("click", () => {
    if (!currentResult) return;
    navigator.clipboard.writeText(currentResult.engineeringJira.jiraMarkdown);
    alert("Jira Ticket markdown copied to clipboard!");
  });

  function downloadFile(filename: string, content: string) {
    const blob = new Blob([content], { type: "text/markdown;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Initial Run on page load
  runAnalysis();
</script>

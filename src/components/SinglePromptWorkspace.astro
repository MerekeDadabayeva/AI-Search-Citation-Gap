---
---

<div id="singleModeContainer" class="mode-content-container active">
  <!-- Diagnostic Input Bar -->
  <div class="card gap-input-card">
    <div class="input-grid">
      <div class="field">
        <label class="label" for="brandUrlInput">🏢 Your Brand Landing Page (Any URL):</label>
        <input id="brandUrlInput" class="input" type="url" value="https://linear.app" placeholder="https://yourbrand.com" />
      </div>
      <div class="field">
        <label class="label" for="compUrlInput">🏆 Winning Competitor URL (Any URL):</label>
        <input id="compUrlInput" class="input" type="url" value="https://jira.com" placeholder="https://competitor.com" />
      </div>
    </div>

    <div class="query-row">
      <div class="field" style="flex:1">
        <label class="label" for="queryInput">🎯 Monitored Search Prompt / Query (Any Custom Search):</label>
        <input id="queryInput" class="input" type="text" value="fastest issue tracking software for modern engineering teams" placeholder="Enter any search query..." />
      </div>
      <button id="analyzeBtn" class="btn-primary-black">
        <span>🚀 Synthesize Citation Gap</span>
      </button>
    </div>

    <!-- Presets for 1-click loading -->
    <div class="presets-row">
      <span class="presets-label">Popular Live Scenarios:</span>
      <button class="chip chip-active" data-brand="https://linear.app" data-comp="https://jira.com" data-query="fastest issue tracking software for modern engineering teams">⚡ Linear vs Jira</button>
      <button class="chip" data-brand="https://notion.so" data-comp="https://coda.io" data-query="best all-in-one collaborative workspace with ai documentation">📚 Notion vs Coda</button>
      <button class="chip" data-brand="https://our-saas-crm.io" data-comp="https://attio.com" data-query="best b2b crm for fast-growing startups">💼 SaaS CRM vs Attio</button>
      <button class="chip" data-brand="https://our-legacy-tracker.com" data-comp="https://peec.ai" data-query="best generative engine optimization and ai search tracking tool">🌐 Tracker vs Peec AI</button>
    </div>
  </div>

  <!-- Live Scanning Diagnostic Progress Box -->
  <div id="diagnosticScannerCard" class="card diagnostic-scanner-card" style="display: none;">
    <div class="scanner-header">
      <div class="scanner-spinner"></div>
      <div>
        <div class="scanner-title" id="scanStepTitle">Connecting to Competitor Website...</div>
        <div class="scanner-desc" id="scanStepDesc">Scraping live HTML, extracting pricing claims, and parsing product tags</div>
      </div>
    </div>
    <div class="scanner-progress-bar">
      <div class="scanner-progress-fill" id="scanProgressFill"></div>
    </div>
    <div class="scanner-steps">
      <span class="step-item" id="step1">1. Live Page Scraping</span>
      <span class="step-item" id="step2">2. AI Query Intent Diffing</span>
      <span class="step-item" id="step3">3. Generating Fixes</span>
    </div>
  </div>

  <!-- Plain-English Executive Diagnosis Summary Card -->
  <div class="card executive-summary-card" id="executiveSummaryCard">
    <div class="summary-badge-row">
      <span class="exec-badge">🎯 Live Marketing Diagnostic</span>
      <span class="exec-time" id="execTimestamp">Live Scraped &bull; Verified against AI Search</span>
    </div>
    <h2 class="exec-title" id="execTitle">Why Your Competitor is Winning Citations on this Query</h2>
    <p class="exec-text" id="execText">
      When people ask AI about <em>"fastest issue tracking software for modern engineering teams"</em>, AI engines recommend <strong>jira.com</strong> because their website provides <strong>clear numbers</strong> and <strong>readable product tags</strong>. Your page is currently missing these proof points, so AI ignores it.
    </p>
  </div>

  <!-- Plain-English Scorecard Grid -->
  <div class="scorecard-grid" id="scorecardGrid">
    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">1. AI Product Tags</span>
        <span class="stat-badge red">Missing</span>
      </div>
      <div class="stat-number danger" id="statSchemaCount">2</div>
      <div class="stat-hint">AI cannot read your price or category</div>
    </div>

    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">2. Hard Proof Numbers</span>
        <span class="stat-badge amber">Competitor has 4</span>
      </div>
      <div class="stat-number warning" id="statBenchmarkCount">4</div>
      <div class="stat-hint">Your page lacks speed &amp; scale stats</div>
    </div>

    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">3. Missing Key Topics</span>
        <span class="stat-badge purple">4 Keywords</span>
      </div>
      <div class="stat-number purple" id="statEntityCount">4</div>
      <div class="stat-hint">Terms AI expects for this search</div>
    </div>

    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">Projected AI Visibility</span>
        <span class="stat-badge green">After Fixes</span>
      </div>
      <div class="stat-number success" id="statWinProb">88%</div>
      <div class="stat-hint">+41% jump in citation likelihood</div>
    </div>
  </div>

  <!-- Side-by-Side Marketing Comparison Matrix -->
  <div class="card matrix-card">
    <div class="matrix-header">
      <div class="col-category">What AI Looks For</div>
      <div class="col-brand">
        <span class="dot red"></span>
        <span id="labelBrand">Your Page (linear.app)</span>
      </div>
      <div class="col-comp">
        <span class="dot green"></span>
        <span id="labelComp">Winning Competitor (jira.com)</span>
      </div>
    </div>

    <!-- Row 1: AI Product Tags -->
    <div class="matrix-row">
      <div class="row-info">
        <div class="row-title">🏷️ Machine-Readable Product Tags</div>
        <div class="row-desc">Allows AI bots to read your exact product name, pricing, and ratings</div>
      </div>
      <div class="row-cell cell-missing" id="cellSchemaBrand">
        <span class="icon">✗</span>
        <span id="textSchemaBrand">Missing Product &amp; FAQ tags (AI is blind to your pricing)</span>
      </div>
      <div class="row-cell cell-has" id="cellSchemaComp">
        <span class="icon">✓</span>
        <span id="textSchemaComp">Has verified Product, FAQ, and Rating tags</span>
      </div>
    </div>

    <!-- Row 2: Hard Proof Numbers -->
    <div class="matrix-row">
      <div class="row-info">
        <div class="row-title">🔢 Hard Numbers &amp; Benchmarks</div>
        <div class="row-desc">Specific data points quoted in AI summaries</div>
      </div>
      <div class="row-cell cell-missing" id="cellBenchmarkBrand">
        <span class="icon">✗</span>
        <span id="textBenchmarkBrand">No specific numbers on speed, adoption, or entry pricing</span>
      </div>
      <div class="row-cell cell-has" id="cellBenchmarkComp">
        <span class="icon">✓</span>
        <span id="textBenchmarkComp">Quotes: 100,000+ teams, sub-20ms sync, SOC-2 Certified</span>
      </div>
    </div>

    <!-- Row 3: Key Industry Topics -->
    <div class="matrix-row">
      <div class="row-info">
        <div class="row-title">💡 Key Search Topics</div>
        <div class="row-desc">Essential keywords AI associates with this category</div>
      </div>
      <div class="row-cell cell-partial" id="cellEntityBrand">
        <span class="icon">~</span>
        <span id="textEntityBrand">Missing key keywords AI expects for this search</span>
      </div>
      <div class="row-cell cell-has" id="cellEntityComp">
        <span class="icon">✓</span>
        <span id="textEntityComp">Complete coverage across all category search terms</span>
      </div>
    </div>
  </div>

  <!-- Remediation Action Feed Header with View Switcher -->
  <div class="action-feed-header" id="actionsSection">
    <div>
      <h2 class="feed-title">⚡ What You Need to Add (<span id="remediationCount">5 Simple Fixes</span>)</h2>
      <span class="feed-subtitle">Copy-paste these updates into your website to win back citations</span>
    </div>
    <div class="tab-toggle-group">
      <button class="tab-toggle active" id="btnMarketerView">👤 Marketer View (Simple English)</button>
      <button class="tab-toggle" id="btnDevView">💻 Developer View (Code &amp; Tags)</button>
    </div>
  </div>

  <div class="action-items-list" id="actionItemsList"></div>

  <!-- Export & Handoff Bar -->
  <div class="export-handoff-card">
    <div class="handoff-left">
      <div class="handoff-title">Ready to hand off to your team or client?</div>
      <div class="handoff-desc">Export a clean summary for marketing or ready-to-code sprint tickets for developers.</div>
    </div>
    <div class="handoff-actions">
      <button class="btn-outline" id="btnCopyBrief">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span>Copy Marketing Summary</span>
      </button>
      <button class="btn-outline" id="btnDownloadBrief">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        <span>Download Report (.md)</span>
      </button>
      <button class="btn-black" id="btnCopyJira">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        <span>Copy Developer Jira Story</span>
      </button>
    </div>
  </div>
</div>

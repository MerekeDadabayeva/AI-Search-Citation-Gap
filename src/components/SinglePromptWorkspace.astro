---
---

<div id="singleModeContainer" class="mode-content-container active">
  <!-- Diagnostic Input Bar -->
  <div class="card gap-input-card">
    <!-- Top System Mode Status Badge -->
    <div class="engine-mode-status-bar">
      <div class="engine-mode-left">
        <span class="pulse-dot green"></span>
        <span class="engine-mode-label">Engine Mode: <strong>Zero-Extrapolation AST Synthesizer</strong></span>
        <span class="engine-mode-sub">(Deterministic Client-Side • 100% Availability • No API Key Required)</span>
      </div>
      <div class="engine-mode-right">
        <span class="telemetry-badge" id="btnToggleTelemetry" title="Click to view recruiter observability log">
          📊 Observability: <span id="telemetryEventCount">Active</span>
        </span>
      </div>
    </div>

    <!-- Target Engine GEO Switcher (Diagnostic 8) -->
    <div class="target-engine-selector-container">
      <span class="engine-selector-label">🎯 Target AI Engine:</span>
      <div class="engine-pills-group" id="enginePillsGroup">
        <button class="engine-pill-btn active" data-engine="chatgpt">
          <span class="engine-pill-icon">🤖</span>
          <span>ChatGPT Search (GPT-4o)</span>
          <span class="engine-pill-badge">JSON-LD Schemas</span>
        </button>
        <button class="engine-pill-btn" data-engine="perplexity">
          <span class="engine-pill-icon">⚡</span>
          <span>Perplexity Sonar</span>
          <span class="engine-pill-badge">Fresh Proof Stats</span>
        </button>
        <button class="engine-pill-btn" data-engine="gemini">
          <span class="engine-pill-icon">🌐</span>
          <span>Google AI Overviews</span>
          <span class="engine-pill-badge">Knowledge Graph</span>
        </button>
      </div>
    </div>

    <div class="input-grid">
      <div class="field">
        <label class="label" for="brandUrlInput">🏢 Your Brand Landing Page (Attio):</label>
        <input id="brandUrlInput" class="input" type="url" value="https://attio.com" placeholder="https://attio.com" />
      </div>
      <div class="field">
        <label class="label" for="compUrlInput">🏆 Winning Competitor URL (Any URL):</label>
        <input id="compUrlInput" class="input" type="url" value="https://hubspot.com" placeholder="https://competitor.com" />
      </div>
    </div>

    <div class="query-row">
      <div class="field" style="flex:1">
        <label class="label" for="queryInput">🎯 Monitored Search Prompt / Query (Multi-Intent Supported):</label>
        <input id="queryInput" class="input" type="text" value="top collaborative crm software with automated pipelines" placeholder="Enter any search query..." />
      </div>
      <button id="analyzeBtn" class="btn-primary-black">
        <span>🚀 Synthesize Citation Gap</span>
      </button>
    </div>

    <!-- Presets for 1-click loading -->
    <div class="presets-row">
      <span class="presets-label">Attio Live Scenarios:</span>
      <button class="chip chip-active" data-brand="https://attio.com" data-comp="https://hubspot.com" data-query="top collaborative crm software with automated pipelines">🎯 Attio vs HubSpot (Multi-Intent)</button>
      <button class="chip" data-brand="https://attio.com" data-comp="https://monday.com" data-query="best b2b crm for fast-growing startups">⚡ Attio vs Monday.com</button>
      <button class="chip" data-brand="https://attio.com" data-comp="https://salesforce.com" data-query="best enterprise crm with real-time data sync and apis">💼 Attio vs Salesforce</button>
      <button class="chip" data-brand="https://attio.com" data-comp="https://pipedrive.com" data-query="fastest sales pipeline tracking software for modern tech teams">🚀 Attio vs Pipedrive</button>
    </div>
  </div>

  <!-- Observability Drawer (Recruiter verification for Diagnostic 9) -->
  <div class="card telemetry-drawer-card" id="telemetryDrawerCard" style="display: none;">
    <div class="telemetry-header">
      <div class="telemetry-title">
        <span>📊 Session Telemetry &amp; Recruiter Observability Log</span>
        <span class="badge-pill badge-green">Live Event Stream</span>
      </div>
      <button class="btn-small-outline" id="btnCloseTelemetry">Close ✕</button>
    </div>
    <p class="telemetry-sub">Tracks feature adoption, Jira export frequency, and intent analysis dwell time for product measurement.</p>
    <div class="telemetry-stream" id="telemetryEventStream"></div>
  </div>

  <!-- Live Scanning Diagnostic Progress Box -->
  <div id="diagnosticScannerCard" class="card diagnostic-scanner-card" style="display: none;">
    <div class="scanner-header">
      <div class="scanner-spinner"></div>
      <div>
        <div class="scanner-title" id="scanStepTitle">Connecting to Competitor Website...</div>
        <div class="scanner-desc" id="scanStepDesc">Scraping live HTML, extracting pricing claims, and parsing product tags</div>
      </div>
    </div>
    <div class="scanner-progress-bar">
      <div class="scanner-progress-fill" id="scanProgressFill"></div>
    </div>
    <div class="scanner-steps">
      <span class="step-item" id="step1">1. Live Page Scraping / CORS Fallback</span>
      <span class="step-item" id="step2">2. Multi-Intent Deconstruction</span>
      <span class="step-item" id="step3">3. Generating Zero-Extrapolation Fixes</span>
    </div>
  </div>

  <!-- CORS / Cloudflare Degradation Notification Banner (Diagnostic 1) -->
  <div class="cors-notice-banner" id="corsNoticeBanner" style="display: none;">
    <div class="cors-notice-icon">⚠️</div>
    <div class="cors-notice-content">
      <div class="cors-notice-title" id="corsNoticeTitle">Live Scraping Blocked by CORS/Cloudflare</div>
      <div class="cors-notice-text" id="corsNoticeText">
        Enterprise B2B target enforces strict browser CORS &amp; Cloudflare bot protection on GitHub Pages. Switched automatically to verified high-fidelity DOM snapshot payload to ensure 100% demo SLA.
      </div>
    </div>
    <span class="badge-pill badge-green" style="margin-left:auto; align-self: center;">Snapshot Active</span>
  </div>

  <!-- Plain-English Executive Diagnosis Summary Card (hidden until analysis runs) -->
  <div class="card executive-summary-card" id="executiveSummaryCard" style="display: none;">
    <div class="summary-badge-row">
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <span class="exec-badge" id="execEngineBadge">🎯 Live GEO Diagnostic</span>
        <span class="exec-time" id="execTimestamp"></span>
      </div>
      <div class="exec-quick-actions">
        <button class="btn-small-outline" id="btnTopCopyJira" title="Copy Developer Jira Story">⚡ Copy Jira Story</button>
        <button class="btn-small-outline" id="btnTopCopyBrief" title="Copy Marketing Summary">📄 Copy Brief</button>
        <button class="btn-small-outline" id="btnTopDownloadBrief" title="Download .md Report">⬇️ Download .md</button>
      </div>
    </div>
    <h2 class="exec-title" id="execTitle"></h2>
    <p class="exec-text" id="execText"></p>
    
    <!-- Target Engine Strategic Focus Box (Diagnostic 8) -->
    <div class="engine-advice-callout" id="engineAdviceCallout">
      <div class="advice-header">
        <strong id="engineAdviceTitle">🤖 ChatGPT Search (GPT-4o) Ranking Signal:</strong>
      </div>
      <div class="advice-body" id="engineAdviceText"></div>
    </div>
  </div>

  <!-- Query Intent Extraction Breakdown (Diagnostic 2) -->
  <div class="card query-intent-card" id="queryIntentCard" style="display: none;">
    <div class="card-header" style="margin-bottom: 12px;">
      <div>
        <h3 class="card-title">🎯 Query Intent Extraction &amp; Decomposition</h3>
        <p class="card-subtitle">Deconstructing multi-intent search prompt into explicit LLM evaluation criteria</p>
      </div>
      <span class="badge-pill badge-purple">Multi-Intent Grounding</span>
    </div>
    <div class="intent-grid" id="intentGrid"></div>
  </div>

  <!-- Dynamic Plain-English Scorecard Grid (hidden until analysis runs) -->
  <div class="scorecard-grid" id="scorecardGrid" style="display: none;">
    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">1. AI Product Tags</span>
        <span class="stat-badge red" id="statSchemaBadge"></span>
      </div>
      <div class="stat-number danger" id="statSchemaCount"></div>
      <div class="stat-hint" id="statSchemaHint"></div>
    </div>

    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">2. Hard Proof Numbers</span>
        <span class="stat-badge amber" id="statBenchmarkBadge"></span>
      </div>
      <div class="stat-number warning" id="statBenchmarkCount"></div>
      <div class="stat-hint" id="statBenchmarkHint"></div>
    </div>

    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">3. Missing Key Topics</span>
        <span class="stat-badge purple" id="statEntityBadge"></span>
      </div>
      <div class="stat-number purple" id="statEntityCount"></div>
      <div class="stat-hint" id="statEntityHint"></div>
    </div>

    <div class="card stat-box">
      <div class="stat-top">
        <span class="stat-label">Evidence Grounding</span>
        <span class="stat-badge green" id="statWinBadge"></span>
      </div>
      <div class="stat-number success" id="statWinProb"></div>
      <div class="stat-hint" id="statWinHint"></div>
    </div>
  </div>

  <!-- Side-by-Side Marketing Comparison Matrix (hidden until analysis runs) -->
  <div class="card matrix-card" id="matrixCard" style="display: none;">
    <div class="matrix-header">
      <div class="col-category">What AI Looks For</div>
      <div class="col-brand">
        <span class="dot red"></span>
        <span id="labelBrand"></span>
      </div>
      <div class="col-comp">
        <span class="dot green"></span>
        <span id="labelComp"></span>
      </div>
    </div>

    <!-- Row 1: AI Product Tags -->
    <div class="matrix-row">
      <div class="row-info">
        <div class="row-title">🏷️ Machine-Readable Product Tags</div>
        <div class="row-desc">Allows AI bots to read your exact product name, pricing, and ratings</div>
      </div>
      <div class="row-cell cell-missing" id="cellSchemaBrand">
        <span class="icon">✗</span>
        <span id="textSchemaBrand"></span>
      </div>
      <div class="row-cell cell-has" id="cellSchemaComp">
        <span class="icon">✓</span>
        <span id="textSchemaComp"></span>
      </div>
    </div>

    <!-- Row 2: Hard Proof Numbers -->
    <div class="matrix-row">
      <div class="row-info">
        <div class="row-title">🔢 Hard Numbers &amp; Benchmarks</div>
        <div class="row-desc">Specific data points quoted in AI summaries</div>
      </div>
      <div class="row-cell cell-missing" id="cellBenchmarkBrand">
        <span class="icon">✗</span>
        <span id="textBenchmarkBrand"></span>
      </div>
      <div class="row-cell cell-has" id="cellBenchmarkComp">
        <span class="icon">✓</span>
        <span id="textBenchmarkComp"></span>
      </div>
    </div>

    <!-- Row 3: Key Industry Topics -->
    <div class="matrix-row">
      <div class="row-info">
        <div class="row-title">💡 Key Search Topics</div>
        <div class="row-desc">Essential keywords AI associates with this category</div>
      </div>
      <div class="row-cell cell-partial" id="cellEntityBrand">
        <span class="icon">~</span>
        <span id="textEntityBrand"></span>
      </div>
      <div class="row-cell cell-has" id="cellEntityComp">
        <span class="icon">✓</span>
        <span id="textEntityComp"></span>
      </div>
    </div>
  </div>

  <!-- Data Sanitization & Token Optimization Architecture Drawer (Diagnostic 5) -->
  <div class="card sanitization-card" id="sanitizationPipelineCard" style="display: none;">
    <div class="sanitization-header" id="btnToggleSanitization">
      <div class="sanitization-title-group">
        <span class="sanitization-badge">⚡ Unit Economics &amp; Token Architecture</span>
        <div class="sanitization-title">Data Sanitization Pipeline &bull; Protecting LLM Inference COGS</div>
      </div>
      <span class="sanitization-toggle" id="sanitizationToggleText">Show Pipeline Architecture ▾</span>
    </div>

    <div class="sanitization-content" id="sanitizationContent" style="display: none;">
      <p class="sanitization-desc">
        To eliminate astronomical token costs and 15s+ LLM inference latencies, our pre-processing pipeline strips raw HTML down to core semantic anchors and JSON-LD schemas before executing zero-extrapolation AST diffing.
      </p>

      <div class="pipeline-stages-grid">
        <div class="pipeline-stage">
          <div class="stage-num">1</div>
          <div class="stage-name">Raw DOM Ingestion</div>
          <div class="stage-metric" id="sanRawDomMetric">~1,450 KB</div>
          <div class="stage-sub">HTML, inline CSS, JS bundles, tracking pixels</div>
        </div>

        <div class="pipeline-arrow">➔</div>

        <div class="pipeline-stage">
          <div class="stage-num">2</div>
          <div class="stage-name">Semantic Extraction</div>
          <div class="stage-metric">~18 KB</div>
          <div class="stage-sub">Isolates &lt;main&gt;, headings, &amp; schema tags</div>
        </div>

        <div class="pipeline-arrow">➔</div>

        <div class="pipeline-stage">
          <div class="stage-num">3</div>
          <div class="stage-name">AST Tokenization</div>
          <div class="stage-metric" id="sanCorpusMetric">~1.8 KB</div>
          <div class="stage-sub">Normalized entity proof &amp; pricing claims</div>
        </div>

        <div class="pipeline-arrow">➔</div>

        <div class="pipeline-stage highlight">
          <div class="stage-num">4</div>
          <div class="stage-name">Zero-Extrapolation Diff</div>
          <div class="stage-metric" id="sanSavingsMetric">98.6% Token Savings</div>
          <div class="stage-sub">&lt;45ms SLA &bull; $0 Hallucination Risk</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Remediation Action Feed Header with View Switcher (hidden until analysis runs) -->
  <div class="action-feed-header" id="actionsSection" style="display: none;">
    <div>
      <h2 class="feed-title">⚡ What You Need to Add (<span id="remediationCount"></span>)</h2>
      <span class="feed-subtitle">Copy-paste these updates into your website to win back citations</span>
    </div>
    <div class="tab-toggle-group">
      <button class="tab-toggle active" id="btnMarketerView">👤 Marketer View (Simple English)</button>
      <button class="tab-toggle" id="btnDevView">💻 Developer View (Code &amp; Tags)</button>
    </div>
  </div>

  <div class="action-items-list" id="actionItemsList"></div>

  <!-- Inspectable Grounding Payload Drawer (PRD Section 5: Data Provenance & Zero-Extrapolation Audit Trail) -->
  <div class="card audit-payload-card" id="auditPayloadCard" style="display: none;">
    <div class="audit-drawer-header" id="btnToggleAuditDrawer">
      <div class="audit-header-left">
        <span class="audit-badge">🛡️ Grounding &amp; Provenance</span>
        <div class="audit-title">Inspect Scraped Grounding Payload &bull; Zero-Extrapolation Audit Trail</div>
      </div>
      <div class="audit-toggle-btn">
        <span id="auditToggleText">Show Raw Payload ▾</span>
      </div>
    </div>

    <div class="audit-drawer-content" id="auditDrawerContent" style="display: none;">
      <div class="audit-meta-grid">
        <div class="audit-meta-item">
          <span class="audit-meta-label">Brand Fetch Status:</span>
          <span class="audit-meta-val" id="auditBrandStatus">200 OK &bull; Live Scraped</span>
        </div>
        <div class="audit-meta-item">
          <span class="audit-meta-label">Competitor Fetch Status:</span>
          <span class="audit-meta-val" id="auditCompStatus">200 OK &bull; Live Scraped</span>
        </div>
        <div class="audit-meta-item">
          <span class="audit-meta-label">Competitor Live Verification:</span>
          <a href="#" target="_blank" rel="noopener noreferrer" class="audit-link" id="auditVerifySourceLink">Verify Competitor Source ↗</a>
        </div>
        <div class="audit-meta-item">
          <span class="audit-meta-label">Audit Timestamp:</span>
          <span class="audit-meta-val" id="auditTimestampText"></span>
        </div>
      </div>

      <div class="audit-payload-sections">
        <div class="audit-box">
          <div class="audit-box-title">🏢 Attio (Your Page) Extracted Corpus:</div>
          <pre><code id="auditBrandCorpus">Loading brand payload...</code></pre>
        </div>
        <div class="audit-box">
          <div class="audit-box-title">🏆 Winning Competitor Extracted Corpus &amp; Claims:</div>
          <pre><code id="auditCompCorpus">Loading competitor payload...</code></pre>
        </div>
      </div>
    </div>
  </div>

  <!-- Export & Handoff Bar (hidden until analysis runs) -->
  <div class="export-handoff-card" id="exportHandoffCard" style="display: none;">
    <div class="handoff-left">
      <div class="handoff-title">Ready to hand off to your team or client?</div>
      <div class="handoff-desc">Export a clean summary for marketing or ready-to-code sprint tickets for developers.</div>
    </div>
    <div class="handoff-actions">
      <button class="btn-outline" id="btnCopyBrief">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span>Copy Marketing Summary</span>
      </button>
      <button class="btn-outline" id="btnDownloadBrief">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        <span>Download Report (.md)</span>
      </button>
      <button class="btn-black" id="btnCopyJira">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        <span>Copy Developer Jira Story</span>
      </button>
    </div>
  </div>
</div>

